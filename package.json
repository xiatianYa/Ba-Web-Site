{
  "name": "ba-launcher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "commit": "git-cz",
    "commit:check": "commitlint --from=HEAD~1 --to=HEAD"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@iconify-json/heroicons": "^1.2.3",
    "@types/node": "^26.2.0",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "commitizen": "^4.3.1",
    "cz-customizable": "^7.5.4",
    "nprogress": "^0.2.0",
    "sass-embedded": "^1.89.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "daisyui": "^5.7.16",
    "dayjs": "^1.11.21",
    "klona": "^2.0.6",
    "pinia": "^4.0.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
